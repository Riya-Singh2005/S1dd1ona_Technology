# =====================================================================
# Siddiona Careers - environment
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never
# commit real values.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at
# build time. Everything else stays on the server. Do not add the
# prefix to a secret.
# =====================================================================

# --- Supabase --------------------------------------------------------
# Project Settings > API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable anon key. Safe in the browser: every request it makes
# is subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bypasses Row Level Security entirely. Server only.
# Reachable solely from src/lib/supabase/admin.ts, which is marked
# `server-only` so the build fails rather than shipping it to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ------------------------------------------------------------
# The public application origin used for absolute links in transactional
# email. No trailing slash. Preview deployments fall back to their Vercel URL;
# canonical SEO URLs always use the production origin from src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://siddiona-demo.workers.dev

# --- Analytics -------------------------------------------------------
# Google Analytics > Admin > Data streams > Web stream > Measurement ID.
# Public identifier only; never place personal data in analytics events.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Email (Resend) --------------------------------------------------
# https://resend.com/api-keys

RESEND_API_KEY=re_your_api_key

# Must be on a domain verified in Resend, or sends are rejected.
CAREERS_FROM_EMAIL="Siddiona Careers <careers@example.com>"

# Who receives new-application notifications. Comma separated for
# several recipients; each is sent individually so one bad address
# cannot suppress the rest.
CAREERS_NOTIFICATION_EMAIL=admin@example.com

# --- Website contact form --------------------------------------------
# Uses the same RESEND_API_KEY above. This sender must use a domain
# verified in Resend. Set these in the production hosting environment too.
CONTACT_FROM_EMAIL="Siddiona Technologies <inquiries@example.com>"
CONTACT_TO_EMAIL=sales@example.com

# --- Supabase Send Email hook ----------------------------------------
# Signing secret for the auth email hook, so confirmation and password
# reset messages are sent by Resend through our own templates rather
# than by Supabase's mailer.
#
# Supabase dashboard > Authentication > Hooks > Send Email hook.
# Copy the value exactly as shown, including the `v1,whsec_` prefix.
#
# Without this, /api/auth/send-email rejects every request. Auth email
# then falls back to whatever Supabase is configured to send
SUPABASE_AUTH_HOOK_SECRET=v1,whsec_your_hook_secret
