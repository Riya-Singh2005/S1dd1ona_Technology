{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siddiona-demo",
  "main": ".open-next/worker.js",
  "minify": true,
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "siddiona-demo"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Public, non-secret values. Secrets (SUPABASE_SERVICE_ROLE_KEY,
  // RESEND_API_KEY, SUPABASE_AUTH_HOOK_SECRET) go in the Cloudflare
  // dashboard: Worker > Settings > Variables and Secrets.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://siddiona-demo.example.workers.dev",
    "CAREERS_FROM_EMAIL": "Siddiona Careers <careers@example.com>",
    "CAREERS_NOTIFICATION_EMAIL": "hr@example.com",
    "CONTACT_FROM_EMAIL": "Siddiona Technologies <inquiries@example.com>",
    "CONTACT_TO_EMAIL": "sales@example.com"
  }
}
